[alias]
  # The standards
  st = status
  co = checkout
  cob = checkout -b
  cp = cherry-pick
  br = branch

  # The hits
  up = !git pull --rebase $@ && git submodule update --init --recursive
  wip = !git add -A && git commit -m "WIP"
  omnom = commit --amend -C HEAD
  staged = diff --cached
  rmb = rebase -i $(git mb)

  # Useful
  unstage = rm --cached
  recent-branches = branches-time-sorted --count 10
  diff-commits = log --oneline --graph HEAD..
  merged-branches = !git branch --merged ${1-$(git trunk)}
  dt = -c diff.external=difft diff --ext-diff

  # Good building blocks / private functions
  private-log-plain-graph = log --pretty=format:'%h -%d %s (%cr) <%an>' --abbrev-commit
  private-log-pretty-graph = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  branches-time-sorted= for-each-ref --sort=-committerdate refs/heads/ --format='%(refname:short)'

  # Some more complicated stuff

  # Dynamically determine the 'main' branch name
  trunk = !git symbolic-ref refs/remotes/origin/HEAD | cut -d/ -f4

  # Get the merge-base with the junk in the trunk
  mb = !git merge-base HEAD $(git trunk)

  # Show the graph view of HEAD or given ref, will use the pager
  lg = "!f() { git private-log-pretty-graph ${@-HEAD} ; }; f"

  # Show the last 15 commits in graph view
  ls = "!f() { git --no-pager private-log-pretty-graph -15 ${@-HEAD} ; }; f"

  # fzf all the things! lazygit is also good.
  # # Checkout a recently updated branch from a short fzf menu, the menu shows a graph preview of the branch
  cor = "!f() { git recent-branches | fzf --height=20 --delimiter=' ' --preview='git lg {-1}' --preview-window='70%' | xargs git checkout ; }; f"
  # # Select a branch to delete from a an fzf menu with graph preview
  branch-delete = "!f() { git branch | grep -v '*' | fzf --height=20 --multi --preview='git lg {-1}' --preview-window='70%' | xargs git branch --delete ; }; f"
  # Linear view of commits in fzf, with diff on the right
  browse-commits = "!f() { git log --color --oneline ${@-HEAD} | fzf --tmux=center,90%,border-native --height=+90% --multi --ansi --delimiter=' ' --preview='git show "{1}"' | cut -d' ' -f1 ; }; f"
  # # Find a commit using fzf displayed in graph form. Must be an ancestor of HEAD.
  find-commit = "!f() { git private-log-pretty-graph | fzf --ansi --reverse | sed -E 's/^[^a-f0-9]+//' | awk '{print $1}'; }; f"
  # # As above and use that as the last argument in the given command
  find-commit-and = "!f() { git find-commit | xargs -o ${@-echo} ; }; f"
  # # Add untracked files via fzf
  au = "!f() { git ls-files --others --exclude-standard | fzf --multi --height=10 | xargs git add ; }; f"

  rebase-to = "!f() { git find-commit | xargs -o -I_commit_ git rebase -i _commit_^ ; }; f"
  rebase-on = "!f() { git find-commit | xargs -o -I_commit_ git rebase -i _commit_ ; }; f"

  # Resets the committer date of rewitten/rebased commits to the original time.
  # Goes back to the specified revision.
  date-reset= "!f() { git filter-branch --env-filter 'GIT_COMMITTER_DATE=$GIT_AUTHOR_DATE; export GIT_COMMITTER_DATE' {$1}..HEAD; }; f"

  # Remove all trace of file / pattern
  nuke = "!f() { git filter-branch --force --index-filter \"git rm --cached -r --ignore-unmatch $1\" --prune-empty --tag-name-filter cat -- --all; }; f"

  # You want to rebase your commits but origin/main has changed. AGAIN.
  fucksake = !git up && git rebase $(git trunk) && git push -f

[core]
  attributesfile = ~/.gitattributes
  excludesfile = ~/.gitignore
  editor = vim
  fileMode = false
  pager = less --quit-if-one-screen
[push]
  default = current
[commit]
	verbose = true
[init]
	defaultBranch = main
# [merge]
#   conflictStyle = diff3
[pager]
  difftool = true
