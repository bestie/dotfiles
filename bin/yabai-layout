#!/usr/bin/env bash

# Usage: yabai [option]
# Options:
#     --load-sa              Install and load the scripting-addition.
#     --uninstall-sa         Uninstall the scripting-addition.
#     --install-service      Write launchd service file to disk.
#     --uninstall-service    Remove launchd service file from disk.
#     --start-service        Enable, load, and start the launchd service.
#     --restart-service      Attempts to restart the service instance.
#     --stop-service         Stops a running instance of the service.
#     --message, -m <msg>    Send message to a running instance of yabai.
#     --config, -c <config>  Use the specified configuration file.
#     --verbose, -V          Output debug information to stdout.
#     --version, -v          Print version to stdout and exit.
#     --help, -h             Print options to stdout and exit.
# Type `man yabai` for more information, or visit: https://github.com/koekeishiya/yabai/blob/v7.1.15/doc/yabai.asciidoc

log=/tmp/yabai.log
CURRENT_WINDOW=""

query_current_window() {
  yabai -m query --windows --window
}

current_window_size() {
  query_current_window | jq .frame
}

thirds-cycle() {
  local direction=$1  # horizontal or vertical
  local step=$2       # optional: 1 or -1 to reverse cycle

  step=${step:-1}

  local win=$(query_current_window)
  local win_x=$(printf "%.0f" $(echo "$win" | jq -r '.frame.x'))
  local win_y=$(printf "%.0f" $(echo "$win" | jq -r '.frame.y'))
  echo "Window position: $win_x, $win_y"

  if [ "$direction" = "horizontal" ]; then
    local third_w=$((screen_w / 3))
    local index=$(( (win_x - screen_x) / third_w ))
    local next_index=$(( (index + step + 3) % 3 ))
    move_resize "$((screen_x + third_w * next_index))" "$screen_y" "$third_w" "$screen_h"
  elif [ "$direction" = "vertical" ]; then
    local third_h=$((screen_h / 3))
    local index=$(( (win_y - screen_y) / third_h ))
    local next_index=$(( (index + step + 3) % 3 ))
    move_resize "$screen_x" "$((screen_y + third_h * next_index))" "$screen_w" "$third_h"
  else
    echo "Invalid direction: $direction"
    exit 1
  fi
}

move_to_next_display() {
  yabai -m window --display next
  yabai -m display --focus next
}

# Format is <rows>:<cols>:<start-x>:<start-y>:<width>:<height>

case "$1" in
  fullscreen)
    before=$(current_window_size)
    yabai -m window --grid 1:1:0:0:1:1
    after=$(current_window_size)

    if test "$before" == "$after"; then
      echo "window didn't change, moving to next display" >> $log
      move_to_next_display
    else
      echo "window maximized" >> $log
    fi

    ;;
  half-left)
    yabai -m window --grid 1:2:0:0:1:1
    ;;
  half-right)
    yabai -m window --grid 1:2:1:0:1:1
    ;;
  half-top)
    yabai -m window --grid 2:1:0:0:1:1
    ;;
  half-bottom)
    yabai -m window --grid 2:1:0:1:1:1
    ;;
  sixty-forty-left)
    yabai -m window --grid 1:10:0:0:6:1
    ;;
  sixty-forty-right)
    yabai -m window --grid 1:10:6:0:4:1
    ;;
  sixty-forty-top)
    yabai -m window --grid 10:1:0:0:1:6
    ;;
  sixty-forty-bottom)
    yabai -m window --grid 10:1:0:6:1:4
    ;;
  thirds-1)
    yabai -m window --grid 1:3:0:0:1:1
    ;;
  thirds-2)
    yabai -m window --grid 1:3:1:0:1:1
    ;;
  thirds-3)
    yabai -m window --grid 1:3:2:0:1:1
    ;;
  quads-1)
    yabai -m window --grid 2:2:0:0:1:1
    ;;
  quads-2)
    yabai -m window --grid 2:2:1:0:1:1
    ;;
  quads-3)
    yabai -m window --grid 2:2:0:1:1:1
    ;;
  quads-4)
    yabai -m window --grid 2:2:1:1:1:1
    ;;
  thirds)
    thirds-cycle horizontal
    ;;
  *)
    echo "Usage: $0 {fullscreen|half-left|half-right|half-top|half-bottom|sixty-forty-left|sixty-forty-right|sixty-forty-top|sixty-forty-bottom|thirds-1|thirds-2|thirds-3|quads-1|quads-2|quads-3|quads-4}"
    exit 1
    ;;
esac


